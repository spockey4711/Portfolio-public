# Runtime secrets for the standalone GlitchTip error-tracking stack (S6-2).
# Copy to `.env` next to docker-compose.yml on the server, fill in, chmod 600.
# Never commit the filled-in file. See docs/operations/error-monitoring.md.

# Postgres password for the glitchtip database user. It is interpolated raw into
# DATABASE_URL (postgres://glitchtip:<password>@...), so it MUST be URL-safe -
# no `+`, `/` or `=`. Use hex, which only emits 0-9a-f:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs GlitchTip's own auth/session tokens. Generate once and keep it stable:
#   openssl rand -hex 32
# Rotating this logs all dashboard users out but loses no error data.
SECRET_KEY=

# Public base URL of the dashboard - must match the Nginx server_name and the
# host in the app's NEXT_PUBLIC_SENTRY_DSN.
GLITCHTIP_DOMAIN=https://errors.yannikwuenker.de

# From-address for alert e-mails.
DEFAULT_FROM_EMAIL=errors@yannikwuenker.de

# Optional SMTP for alert e-mails, e.g. smtp://user:pass@smtp.host:587
# Leave unset to write mail to the container log (consolemail://).
EMAIL_URL=
