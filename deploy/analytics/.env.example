# Runtime secrets for the standalone Umami analytics stack (S2-5).
# Copy to `.env` next to docker-compose.yml on the server, fill in, chmod 600.
# Never commit the filled-in file. See docs/operations/analytics.md.

# Postgres password for the umami database user. It is interpolated raw into
# DATABASE_URL (postgresql://umami:<password>@...), so it MUST be URL-safe -
# no `+`, `/` or `=`. Use hex, which only emits 0-9a-f:
#   openssl rand -hex 24
# (Do NOT use `openssl rand -base64`: its `/`, `+`, `=` break URL parsing and
# Umami crash-loops with `TypeError: Invalid URL` in check-db.)
POSTGRES_PASSWORD=

# Signs Umami's own auth/session tokens. Generate once and keep it stable:
#   openssl rand -base64 36
# Rotating this logs all dashboard users out but loses no analytics data.
APP_SECRET=
