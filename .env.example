# Copy to .env (or .env.local for dev) and fill in as needed.
# Every variable is catalogued in docs/operations/environment-variables.md.
# NEXT_PUBLIC_* values are shipped to the browser; never put secrets there.
# The build and dev must succeed with no secrets set (live widgets fall back).

# Public
NEXT_PUBLIC_SITE_URL=https://yannikwuenker.de

# Cookieless Umami analytics (optional - both unset means analytics off).
# Public, inlined at build time; no secret. See docs/operations/analytics.md.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Self-hosted GlitchTip error tracking (optional - unset means tracking off).
# The DSN carries only a public ingest key, no secret; it is inlined at build
# time so the browser SDK can report client-side errors. See
# docs/operations/error-monitoring.md.
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags (optional - unset means off)
# Show the hero "Verfügbar als Werkstudent" pill. Off by default so the site does
# not advertise a job search; set to true and rebuild to enable it.
SHOW_AVAILABILITY=

# Weather (optional - Open-Meteo needs no key)
WEATHER_API_KEY=
WEATHER_LOCATION=Cologne,DE

# GitHub activity (optional - token only raises rate limits)
GITHUB_TOKEN=
GITHUB_USERNAME=spockey4711

# Now-playing (optional, Phase 3)
# Refresh token needs scopes: user-read-currently-playing, user-read-recently-played
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# WakaTime coding stats (optional - key authenticates as its own account)
WAKATIME_API_KEY=
